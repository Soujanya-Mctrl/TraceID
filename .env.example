# =====================================================================
# HH Goa 2026 Shortlisting Task 3: Configuration Environment Variables
# =====================================================================

# ---------------------------------------------------------------------
# 1. Face Engine Settings
# ---------------------------------------------------------------------
# Detection backend: "torch_cnn", "opencv", "mediapipe", or "hybrid"
FACE_DETECTOR_BACKEND=torch_cnn
FACE_EMBEDDING_DIM=512
MIN_FACE_CONFIDENCE=0.85

# ---------------------------------------------------------------------
# 2. Web & Social Media Search Settings
# ---------------------------------------------------------------------
# Search backend: "google_vision", "serpapi", "google_lens", or "scripted"
SEARCH_BACKEND=scripted
# Google Cloud Vision API Key (for Google Vision Web Detection):
GOOGLE_VISION_API_KEY=
# Optional SerpApi Key (for Google Lens engine):
SERPAPI_API_KEY=
# Maximum matching posts to retrieve
MAX_SEARCH_RESULTS=5

# ---------------------------------------------------------------------
# 3. Blockchain Verification Settings
# ---------------------------------------------------------------------
# Blockchain target: "simulated", "local_rpc", "sepolia", "polygon_amoy"
BLOCKCHAIN_NETWORK=simulated

# RPC Endpoint (Used when BLOCKCHAIN_NETWORK is not "simulated")
# e.g., http://127.0.0.1:8545 for local Anvil/Hardhat, or Infura/Alchemy endpoint for testnets
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545

# Deployer / Submitter Private Key (Hex format without 0x prefix, or standard 0x...)
# Note: For "simulated" mode, an ephemeral test key is automatically generated
BLOCKCHAIN_PRIVATE_KEY=0x0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Deployed FaceVerificationRegistry contract address (Optional if deploying dynamically)
CONTRACT_ADDRESS=

# ---------------------------------------------------------------------
# 4. Pipeline & Output Settings
# ---------------------------------------------------------------------
OUTPUT_DIR=output
LOG_LEVEL=INFO
SAVE_VERIFICATION_RECEIPT=true
